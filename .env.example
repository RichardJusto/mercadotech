# Supabase — proyecto en https://app.supabase.com
# URL pública del proyecto (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima/pública (Project Settings > API > anon/public).
# Segura para exponer en el navegador: su alcance lo limita RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de service role (Project Settings > API > service_role).
# SECRETA. Bypasea RLS por completo. Solo en el servidor
# (lib/supabase/admin.ts) — nunca con el prefijo NEXT_PUBLIC_,
# nunca en un commit, nunca en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en redirects de Auth, links de emails, etc.).
# Local: http://localhost:3000 · Producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hugging Face — Settings > Access Tokens > Create new token (tipo "Read").
# SECRETO. Solo en el servidor (lib/ai/), nunca en el navegador ni en un
# commit. Sin esta variable, el chat/búsqueda IA devuelven un error
# controlado; el resto de la app sigue funcionando normal.
HUGGINGFACEHUB_API_TOKEN=

# Opcionales — el nivel gratuito de Hugging Face rota qué modelos están
# disponibles; cambiar estas variables no requiere tocar código.
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
