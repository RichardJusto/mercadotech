# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mcp/node_modules
/mcp/dist
/mcp/*.tsbuildinfo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# reportes de Lighthouse (Fase 7.2): JSON/HTML pesados con screenshots en
# base64 (~5MB) — el resumen permanente vive en docs/PERFORMANCE.md, no hace
# falta versionar los reportes crudos
/docs/lighthouse

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code: overrides personales, no compartidas con el equipo
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
